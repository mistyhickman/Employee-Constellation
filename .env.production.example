# Copy this to `.env` at the repo root before running docker-compose.prod.yml.
# Docker Compose reads `.env` from the same directory as the compose file
# automatically — no extra flag needed.

# A real, random secret — generate with: openssl rand -base64 32
# Every login is signed with this; anyone who has it can forge a session.
JWT_SECRET=

# Change these from the local-dev defaults before exposing this anywhere
# other than your own machine.
POSTGRES_USER=docme360
POSTGRES_PASSWORD=
POSTGRES_DB=docme360

# The public URL people will actually use, e.g. http://<ec2-public-ip>
# (or https://your-domain once TLS is set up — see docs/09-deployment.md).
PUBLIC_ORIGIN=http://localhost

# Set to "true" only after TLS is in front of the app (see docs/09-deployment.md)
# — a secure cookie is silently dropped by browsers over plain HTTP.
COOKIE_SECURE=false

# Set to "true" only for the very first `docker compose up` on a fresh
# database, or after a deliberate reset — reseeding on every restart would
# overwrite anything leadership adds/edits while trying the demo out.
RUN_SEED_ON_START=false
